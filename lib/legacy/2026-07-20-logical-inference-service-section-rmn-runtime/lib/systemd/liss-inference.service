[Unit]
Description=LISS cheapest-sufficient inference broker
Requires=liss-inference.socket
After=liss-inference.socket

[Service]
Type=simple
EnvironmentFile=-%h/.config/561-group/agents.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node %h/services/logical-inference-service-section/src/serve-inference-socket.mjs --registry %h/services/logical-inference-service-section/content/config/inference-fabric-runtime.json --journal %S/liss-inference/results.jsonl --activitystreams-data-root %S/liss-inference --concurrency 6 --max-queue-depth 1024 --restart-on-registry-change --recover-stale-lock
StateDirectory=liss-inference
Restart=on-failure
RestartSec=2
Nice=5
CPUWeight=75
IOWeight=75
MemoryHigh=35%
MemoryMax=50%
MemorySwapMax=0
TasksMax=256
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=default.target
