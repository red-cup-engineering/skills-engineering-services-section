{
  "name": "@emsenn/claude-code-inference-team",
  "version": "0.2.0",
  "description": "A directly contractable Claude Code print-mode inference provider.",
  "type": "module",
  "dependencies": {
    "@emsenn/a2a-services-section": "workspace:*",
    "@emsenn/rmn-semantic-conformance": "workspace:*",
    "@emsenn/rwil-rdf-services": "workspace:*"
  },
  "bin": {
    "solicit-service": "./src/contract-claude-code.js",
    "invoke-service": "./src/contract-claude-code.js",
    "execute-rmn-inference": "./src/execute-rmn-inference.mjs",
    "serve-inference-a2a": "./scripts/serve-a2a.mjs"
  },
  "scripts": {
    "check": "node --check run-one-exchange.mjs && node --check src/law.mjs && node --check src/contract-claude-code.js && node --check src/execute-rmn-inference.mjs && node --check scripts/serve-a2a.mjs",
    "test": "node --test test/contract-claude-code.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sovereign-state-enterprise"
  ],
  "x-agentic-metro-enterprise": {
    "node-id": "claude-code-inference-team",
    "actor": "urn:ame:claude-code-inference-team",
    "account": "eip155:31337:0x415bf4251c62b88ea8b004803ed1aded929660bd",
    "owners": [
      "561-group",
      "red-cup-engineering",
      "logical-inference-service-section"
    ],
    "membrane": {
      "law": "lib/",
      "lasting-instances": "content/",
      "append-only-instances": "data/"
    },
    "admission": "a directly addressed ActivityStreams ServiceSolicitation or an Accept carrying an attenuated capability for one provider-authored executable offer",
    "refusal": "unmatched intent, incomplete packet, changed accepted terms, missing account effects, or exhaustion of the provider's bounded exchange pilot",
    "operation-catalog": {
      "solicit-service": {
        "contract": "ni:///sha-256;J5aoBVzHy53ojBrb0v3rcG51POl0F0JLXBu_yOn4JUM",
        "accepts": "ActivityStreams Offer<ServiceSolicitation>",
        "returns": "ActivityStreams Offer<ExecutableServiceOffer>|Question|Reject",
        "timeoutMs": 30000
      },
      "invoke-service": {
        "contract": "ni:///sha-256;J5aoBVzHy53ojBrb0v3rcG51POl0F0JLXBu_yOn4JUM",
        "accepts": "ActivityStreams Accept<ServiceContract>",
        "returns": "ActivityStreams Accept<ClaudeCodeInferenceResult>|Reject",
        "timeoutMs": 920000
      },
      "execute-rmn-inference": {
        "law": "ni:///sha-256;J5aoBVzHy53ojBrb0v3rcG51POl0F0JLXBu_yOn4JUM",
        "accepts": "A2A 1.0 Message<RMN effect bundle>",
        "returns": "A2A 1.0 Message<RMN witnessed completion or refusal>",
        "protocolProvider": "a2a-services-section",
        "timeoutMs": 920000,
        "compatibility": false
      }
    }
  }
}
