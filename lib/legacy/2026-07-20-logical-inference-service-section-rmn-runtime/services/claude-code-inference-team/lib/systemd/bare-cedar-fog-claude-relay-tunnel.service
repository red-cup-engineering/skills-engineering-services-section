[Unit]
Description=Private Claude relay tunnel from Bare Cedar Fog to Cold Red Gate
After=network-online.target bare-cedar-fog-claude-relay.service
Requires=bare-cedar-fog-claude-relay.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:19762:127.0.0.1:19762 cold-red-gate
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
