{
  "kind": "metroplat.contract",
  "id": "liss-inference-service",
  "material": {
    "id": "liss-cheapest-sufficient-route-material",
    "loci": [
      "consuming-micro-enterprise",
      "logical-inference-service-section",
      "groq-inference-team",
      "nvidia-inference-team",
      "claude-code-inference-team"
    ],
    "incidence": [
      "consumer--solicits-finite-route-from--logical-inference-service-section",
      "logical-inference-service-section--offers-exact-tier-order-models-sufficiency-and-effects-to--consumer",
      "consumer--accepts-offer-with-attenuated-capability-for--logical-inference-service-section",
      "logical-inference-service-section--contracts-each-admissible-child-through-its-own-activitystreams-face",
      "logical-inference-service-section--returns-first-sufficient-completion-or-typed-refusal-to--consumer"
    ],
    "fibers": ["routed-inference-request", "finite-route-plan", "provider-offer", "provider-result", "sufficiency-witness", "routed-result"],
    "valueAlgebra": "completion-or-refusal",
    "constraints": [
      "the-provider-authored-offer-fixes-a-strict-forward-subsequence-of-free-groq-free-nim-leader-claude",
      "a-provider-validated-output-schema-is-admitted-only-on-the-leader-claude-route-and-is-preserved-separately-from-report-prose",
      "every-live-tier-effect-is-authorized-before-invocation-and-preserved-by-the-accepted-capability",
      "output-insufficiency-may-advance-to-the-next-preauthorized-tier",
      "provider-refusal-resource-failure-or-unavailability-is-not-output-insufficiency-and-never-triggers-automatic-escalation",
      "each-child-is-solicited-accepted-and-invoked-through-its-own-advertised-contract-face",
      "each-provider-credential-enters-only-as-invocation-environment-under-the-consuming-clients-resource-grant-and-appears-in-no-record",
      "notebooklm-and-other-artifact-services-remain-outside-this-chat-completion-route"
    ],
    "closure": ["the-route-closes-as-the-first-sufficient-completion-or-one-typed-refusal-with-every-attempt-witnessed"],
    "boundary": ["the-activitystreams-solicitation-and-provider-authored-offer-are-the-inter-enterprise-boundary"]
  },
  "precondition": {
    "id": "typed-route-demand-and-authority-received",
    "description": "A consuming micro-enterprise supplies messages, a strict forward list of admissible tiers, optional per-tier models, replayable prose sufficiency predicates, a token ceiling, and live or dry-run mode. Live invocation also carries an attenuated capability covering every effect named by the provider-authored offer."
  },
  "move": {
    "id": "execute-cheapest-sufficient-forward-route",
    "description": "LISS walks the exact offered tier plan in order. It invokes each child through that child's executable contract face, measures the returned prose against the accepted sufficiency predicates, stops on the first sufficient result, advances only on output insufficiency, and refuses immediately on provider or resource failure.",
    "domain": "routed-inference-request-and-attenuated-capability",
    "codomain": "routed-inference-result-or-refusal",
    "partial": false,
    "deterministic": false,
    "effects": ["material", "boundary", "evidence"]
  },
  "postcondition": {
    "id": "route-settled",
    "description": "LISS's append-only routing-attempt ledger contains the exact tier, provider-owned result, output digest, and sufficiency witness for each attempted tier; the caller receives an ActivityStreams Accept carrying the first sufficient prose result or a Reject naming the exact failed tier and grounds.",
    "entails": ["typed-route-demand-and-authority-received"]
  },
  "phase": {
    "id": "liss-cheapest-sufficient-route-phase",
    "closureDepth": "finite",
    "finality": "normal-form",
    "recurrence": "none",
    "mobility": "fixed",
    "coherence": "total",
    "contradiction": "reject",
    "coordinationCost": "evidenced",
    "observability": "boundary-only",
    "energy": "costed"
  },
  "lens": {
    "id": "liss-cheapest-sufficient-route-lens",
    "domain": "routed-inference-request",
    "boundary": "activitystreams-contract-between-consuming-enterprise-and-liss",
    "preserves": ["tier-order", "models", "messages", "sufficiency-predicates", "token-ceiling", "resource-effects", "provider-owned-results"],
    "hides": ["credentials", "bearer-headers", "provider-internal-request-construction"],
    "output": "first-sufficient-prose-or-typed-refusal",
    "evidenceRequired": true
  },
  "evidencePolicy": {
    "id": "liss-route-evidence-policy",
    "required": true,
    "records": ["provider-local-exchange-record", "liss-routing-attempt", "per-attempt-sufficiency-witness", "liss-causal-event"],
    "time": "interval",
    "caller": "required",
    "boundaryObject": "full"
  },
  "energetics": [{
    "kind": "metroplat.energetic-obligation",
    "id": "bounded-route-fuel",
    "law": "total-correctness-under-finite-tier-and-runtime-bounds",
    "behavior": "Every offered route terminates as completion or refusal; provider resource failure never burns a more expensive fallback grant automatically.",
    "source": "typed-route-demand-and-authority-received",
    "target": "route-settled",
    "invariant": "attempt-count-does-not-exceed-admissible-tier-count-and-every-attempt-is-recorded",
    "measure": "provider requests wall-clock seconds model usage and selected tier",
    "evidenceRequired": true
  }],
  "refinements": [{
    "id": "activitystreams-contract-router-realizes-the-move",
    "implementation": "src/contract-routed-inference.js with src/routing-law.mjs",
    "refines": "tool",
    "preserves": ["finite-forward-route", "provider-contract-boundaries", "no-secret-recording", "provider-failure-is-not-sufficiency"]
  }]
}
