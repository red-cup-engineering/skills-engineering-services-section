{
  "name": "@red-cup-engineering/skills-services-section",
  "version": "0.1.0",
  "description": "Writes one Agent Skills SKILL.md through the Markdown file writing service.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/skills-engineering-services-section.git"
  },
  "type": "module",
  "license": "MIT",
  "private": false,
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/write-agent-skill.mjs"
