/node_modules/

# Logs live in machine state (~/.local/state/561-group/settlements/computer-inference-engine/data/logs); data/logs links there and is never tracked.
/data/logs

# Runtime state is never tracked: the liveness reading, provider request slots and their last-admission readings, and locks.
/data/state/provider-card-liveness-state/
/data/state/provider-capacity-state/
/data/state/*-lock-state/
*.lock
*.lock.stale-*
