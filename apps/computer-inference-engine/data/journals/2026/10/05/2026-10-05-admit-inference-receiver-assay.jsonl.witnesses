"pair\",[\"pair\",[\"mark\",\"\\\"delivery\\\"\"],[\"pair\",[\"mark\",\"\\\"sen.json.string\\\"\"],[\"mark\",\"\\\"{\\\\n  \\\\\\\"preservedEffect\\\\\\\": \\\\\\\"The canonical module proposal interface `deriveJsnodeModules` produces a frozen `JsnodeModuleProposal` object containing files, tests, and a derivation record, strictly enforcing schema paths, dependency versions, and operation uniqueness. It does not mutate source code directly but prepares a structured payload for downstream consumption.\\\\\\\",\\\\n  \\\\\\\"reuse\\\\\\\": \\\\\\\"The validation logic for schema paths (`data/`) and module paths (`src/`) in `deriveJsnodeModules` can be conceptually reused, but the function itself cannot be reused to receive the proposal because it does not accept a `JsnodeModuleProposal` as input; it only outputs one. The existing receiver `induceVerifiedSoftwareMissionProposal` is incompatible due to type mismatch (`SoftwareMissionChangeProposal` vs `JsnodeModuleProposal`).\\\\\\\",\\\\n  \\\\\\\"missingBindings\\\\\\\": [\\\\n    \\\\\\\"No function accepts `JsnodeModuleProposal` as input\\\\\\\",\\\\n    \\\\\\\"No binding exists to apply `files` from the proposal to the repository root\\\\\\\",\\\\n    \\\\\\\"No binding maps `JsnodeModuleProposal` fields to the `proposal.changes` format required by existing patterns if any generic applier were to be used\\\\\\\",\\\\n    \\\\\\\"No verification or acceptance commands are bound to the module derivation workflow\\\\\\\"\\\\n  ],\\\\n  \\\\\\\"prohibitedShortcuts\\\\\\\": [\\\\n    \\\\\\\"Do not pass `JsnodeModuleProposal` directly to `induceVerifiedSoftwareMissionProposal`\\\\\\\",\\\\n    \\\\\\\"Do not mutate the frozen proposal object inside the receiver\\\\\\\",\\\\n    \\\\\\\"Do not assume `files` paths are safe without re-validating against `writablePaths`\\\\\\\",\\\\n    \\\\\\\"Do not skip schema or digest verification in the receiving step\\\\\\\"\\\\n  ],\\\\n  \\\\\\\"smallestCoherentChange\\\\\\\": \\\\\\\"Create a new receiver function `induceVerifiedJsnodeModuleProposal` that accepts a `JsnodeModuleProposal` and an options object. This function must: 1) Validate the proposal type, 2) Extract `files` and `dependencies`, 3) Map file paths to writable paths with strict containment checks, 4) Apply changes via a safe file-writing utility (not `restoreChanges` which expects a different schema), and 5) Run verification/acceptance commands. This replaces the non-existent receiver for this specific proposal type.\\\\\\\",\\\\n  \\\\\\\"unresolved\\\\\\\": [\\\\n    \\\\\\\"The existing receiver `induceVerifiedSoftwareMissionProposal` does not accept `JsnodeModuleProposal`; it expects `SoftwareMissionChangeProposal`. Therefore, the existing receiver does NOT actually receive canonical module proposals.\\\\\\\",\\\\n    \\\\\\\"It is unclear if `dependencies` from the proposal should be written to `package.json` or handled separately.\\\\\\\",\\\\n    \\\\\\\"The `tests` field in the proposal is not clearly bound to any test execution in the receiver context.\\\\\\\",\\\\n    \\\\\\\"The exact format of `verifyCommand` and `acceptanceCommand` for JS module validation is not specified in the existing code provided.\\\\\\\"\\\\n  ]\\\\n}\\\"\"]]],[\"pair\",[\"pair\",[\"mark\",\"\\\"id\\\"\"],[\"pair\",[\"mark\",\"\\\"sen.json.string\\\"\"],[\"mark\",\"\\\"ni:///sha-256;GQo1vOYy0Cz2b9bWl0g0eL7ck6ADoXFY5TwTBATqj5Q\\\"\"]]],[\"pair\",[\"pair\",[\"mark\",\"\\\"measuredResources\\\"\"],[\"pair\",[\"mark\",\"\\\"sen.json.object\\\"\"],[\"pair\",[\"pair\",[\"mark\",\"\\\"callerObservedResources\\\"\"],[\"pair\",[\"mark\",\"\\\"sen.json.array\\\"\"],[\"star\"]]],[\"pair\",[\"pair\",[\"mark\",\"\\\"partialResources\\\"\"],[\"pair\",[\"mark\",\"\\\"sen.json.array\\\"\"],[\"star\"]]],[\"pair\",[\"pair\",[\"mark\",\"\\\"resources\\\"\"],[\"pair\",[\"mark\",\"\\\"sen.json.array\\\"\"],[\"pair\",[\"pair\",[\"mark\",\"\\\"sen.json.object\\\"\"],[\"pair\",[\"pair\",[\"mark\",\"\\\"amount