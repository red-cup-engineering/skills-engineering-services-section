  "precondition": {
    "id": "context-packet-and-client-key-received",
    "description": "A consuming micro-enterprise, over A2A, has sent a typed context packet naming: model (a GitHub Models model id), messages (a non-empty array of {role, content} chat turns), and optionally max-tokens and a params object for provider-specific fields — and has supplied, from its own custody, the GITHUB_MODELS_TOKEN auth material as environment at invocation."
  },
  "move": {
    "id": "realize-the-exchange",
    "description": "The unit issues one Bearer-authenticated HTTPS POST to https://models.github.ai/inference/chat/completions with the packet's model and messages, within a bounded fuel budget, and settles to exactly one of the two typed outcomes.",
    "domain": "context-packet",
    "codomain": "completion-or-refusal",
    "partial": false,
    "deterministic": false,
    "effects": [
      "material",
      "boundary",
      "evidence"
    ]
  },
  "postcondition": {
    "id": "exchange-settled",
    "description": "An exchange record exists in the unit's own content/exchanges/ pool whose .outcome is exactly 'completion' (carrying the served model, response text, and finish reason) or 'refusal' (a structured refusal record stating grounds) — settled within the bounded fuel budget, never a hang and never an untyped failure, and never carrying the client's credential.",
    "entails": [
      "context-packet-and-client-key-received"
    ]
  },
  "phase": {
    "id": "github-models-inference-exchange-phase",
