[Unit]
Description=Bare Cedar Fog locally operated inference A2A provider
After=network-online.target bare-cedar-fog-rmn-semantic-conformance.service witness-journal-rdf-projection-service.service wit-transition-assay.service
Wants=network-online.target
Requires=bare-cedar-fog-rmn-semantic-conformance.service witness-journal-rdf-projection-service.service wit-transition-assay.service

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/logical-inference-service-section/services/bare-cedar-fog-npu-inference-team
Environment=PORT=8795
Environment=SETTLEMENT_CAIP2=eip155:5615610
Environment=HOST=127.0.0.1
Environment=BASE_URL=https://bare-cedar-fog.561.group/a2a/local-inference
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=RMN_CONFORMANCE_AGENT=http://127.0.0.1:8786/.well-known/agent-card.json
Environment=WITNESS_JOURNAL_RDF_AGENT=http://127.0.0.1:19764/.well-known/agent-card.json
Environment=WIT_TRANSITION_ASSAY_AGENT=http://127.0.0.1:19827/.well-known/agent-card.json
Environment=AGENT_CARD_SIGNING_KEY=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/logical-inference-service-section/services/bare-cedar-fog-npu-inference-team/data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/logical-inference-service-section/services/bare-cedar-fog-npu-inference-team/content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=bare-cedar-fog-local-inference-ed25519
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node bin/serve-a2a.mjs
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
