[Unit]
Description=Expected-resolution inference pricing service (rank/deliver/observe/refuse)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/info/lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-inference-system-services-section/services/inference-dispatch-service
Environment=PORT=8800
ExecStart=%h/.local/bin/node scripts/serve-expected-resolution-pricing.mjs
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
