{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-cup-engineering:schema:inference-work-result:1",
  "type": "object",
  "required": ["outcome", "integrationAccepted", "provider", "configurationIdentity", "configuration"],
  "properties": {
    "outcome": { "enum": ["candidate-pending-customer-acceptance", "candidate-pending-codex-acceptance", "candidate-pending-claude-acceptance"] },
    "provider": { "type": "string", "minLength": 1 },
    "configurationIdentity": { "type": "string", "minLength": 1 },
    "configuration": { "type": "object" },
    "integrationAccepted": { "const": false }
  }
}
