{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-cup-engineering:schema:inference-work-request:1",
  "type": "object",
  "required": ["objective"],
  "properties": {
    "objective": { "type": "string", "pattern": "\\S" },
    "chatCompletion": { "$ref": "urn:red-cup-engineering:schema:chat-completion-turn-input:1" },
    "context": { "type": "string" },
    "contextPacket": { "type": "object" },
    "contextOptimization": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["automatic", "exact"] },
        "maximumInputTokens": { "type": "integer", "minimum": 1 },
        "estimatedCharsPerToken": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "desiredUse": { "type": "string", "minLength": 1 },
    "workType": { "type": "string", "minLength": 1, "description": "The semantic service class required from the provider; a work class is not itself a provider capability." },
    "taskClass": { "type": "string", "pattern": "\\S", "description": "The receiver's semantic outcome class for routing history; it does not constrain provider capabilities." },
    "requiredCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "description": "Provider interface features required by this request, such as chat, tool-calling, or json-schema-output. Work type and task class are carried separately." },
    "requiredQualityTiers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "difficulty": { "type": "number", "minimum": 0, "maximum": 1 },
    "outputSchema": { "type": "object" },
    "outputProjection": {
      "type": "object",
      "oneOf": [
        { "required": ["type", "path"], "properties": { "type": { "enum": ["single-file-create", "single-source-artifact"] }, "path": { "type": "string", "minLength": 1 } } },
        { "required": ["type"], "properties": { "type": { "const": "fenced-json-tool-call" } } }
      ]
    },
    "enforceProviderSchema": { "type": "boolean" },
    "excludeProviders": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "customer": { "type": "string", "minLength": 1 },
    "workLotId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["dry-run", "live"] },
    "considerationPolicy": { "type": "object" },
    "routingProfile": { "enum": ["bounded", "extended"] },
    "extendedRoutingRationale": { "type": "string", "pattern": "\\S" },
    "energyProvenance": { "type": "object" },
    "zeroCashOnly": { "type": "boolean" },
    "workPlacement": {
      "type": "object",
      "properties": {
        "evaluatedAt": { "type": "string", "minLength": 1 },
        "accountIdentity": { "type": "string", "minLength": 1 },
        "windowIdentity": { "type": "string", "minLength": 1 },
        "requiredImplementationIdentity": { "type": "string", "minLength": 1 },
        "unknownAvailability": { "enum": ["permit", "refuse"] },
        "resourceCeilings": { "$ref": "#/$defs/resources" },
        "availabilityEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["providerIdentity", "accountIdentity", "windowIdentity", "observedAt", "availableResources"],
            "properties": {
              "providerIdentity": { "type": "string", "minLength": 1 },
              "accountIdentity": { "type": "string", "minLength": 1 },
              "windowIdentity": { "type": "string", "minLength": 1 },
              "observedAt": { "type": "string", "minLength": 1 },
              "validFrom": { "type": "string", "minLength": 1 },
              "validUntil": { "type": "string", "minLength": 1 },
              "resetsAt": { "type": "string", "minLength": 1 },
              "availableResources": { "$ref": "#/$defs/resources" }
            },
            "additionalProperties": false
          }
        },
        "observations": { "type": "array", "items": { "type": "object" } },
        "networkBytes": { "type": "integer", "minimum": 0 },
        "excludedOffers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "agentBounds": {"type":"object","properties":{"maximumRequests":{"type":"integer","minimum":1,"maximum":128},"maximumToolCalls":{"type":"integer","minimum":0,"maximum":128},"maximumOutputTokens":{"type":"integer","minimum":1,"maximum":1048576},"maximumDepth":{"type":"integer","minimum":0,"maximum":8},"maximumTokensPerRequest":{"type":"integer","minimum":1,"maximum":16384},"maximumToolRounds":{"type":"integer","minimum":0,"maximum":32}},"additionalProperties":false}
  },
  "additionalProperties": false,
  "if": { "required": ["chatCompletion"] },
  "then": { "not": { "anyOf": [
    { "required": ["outputSchema"] },
    { "required": ["outputProjection"] },
    { "required": ["enforceProviderSchema"], "properties": { "enforceProviderSchema": { "const": true } } }
  ] } },
  "$defs": {
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource", "unit", "amount"],
        "properties": {
          "resource": { "type": "string", "minLength": 1 },
          "asset": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "amount": {
            "type": "object",
            "required": ["numerator", "denominator"],
            "properties": { "numerator": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" }, "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" } },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
