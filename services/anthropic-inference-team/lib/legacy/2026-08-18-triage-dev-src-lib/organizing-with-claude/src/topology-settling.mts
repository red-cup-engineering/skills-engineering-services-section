// topology-settling — shared utterance-log settlement for claude's topology
// carriers, reconstructed directly on the relating substrate (the dropped animating
// wrapper `settleUtterances`): articulate → predicate → posit → settle / read fixed
// points. Plus the agent-term namer (fresh animating identifies agents by bare
// string, so a topology carrier names its agent edge itself). A computing-with-*
// carrier settles its own topology on relating, the stronger base.

import {
  articulate,
  predicate,
  predicationSite,
  posit,
  settle,
  fixedPoints,
  fixedPointReadings,
  type UtteranceCarrier,
  type SettlementFiltration,
  type MemeTopologyFixedPointReadings,
} from "@emsenn/relating";

function memeTopologyOf(log: readonly UtteranceCarrier[]): {
  readonly settling: SettlementFiltration;
  readonly readings: MemeTopologyFixedPointReadings;
} {
  const generated = log.map((carrier) => predicate(articulate(carrier)));
  const predicated = predicationSite(generated.flatMap((site) => [...site.cells.cells, ...site.specializations]));
  const posited = posit(predicated);
  return { settling: settle(posited), readings: fixedPointReadings(fixedPoints(posited)) };
}

/** The settlement filtration generated by an utterance log. */
export function settleUtterances(log: readonly UtteranceCarrier[]): SettlementFiltration {
  return memeTopologyOf(log).settling;
}

/** The fixed-point readings of the meme topology over an utterance log. */
export function fixedPointReadingsOfUtterances(log: readonly UtteranceCarrier[]): MemeTopologyFixedPointReadings {
  return memeTopologyOf(log).readings;
}

/** Namespaced term for the agent a carrier realizes: "agent.<id>". */
export function agentTerm(id: string): string {
  return `agent.${id}`;
}
