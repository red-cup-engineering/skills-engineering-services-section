{
  "name": "@emsenn/organizing-with-claude",
  "version": "0.0.0",
  "type": "module",
  "description": "Organizing with Claude: the Claude-specific organizing fiber over the 561 Group workspace, including Claude topology, Claude Code CLI harness topology, live .mcp.json/.claude/settings.json harness projection, and a Claude inference wrapper over @emsenn/organizing-with-llm-agents/holography downstream of organizing.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/scripts/harness.mjs",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "bin": {
    "organizing-with-claude-harness": "./dist/scripts/harness.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./claude": {
      "types": "./dist/claude/index.d.mts",
      "import": "./dist/claude/index.mjs"
    },
    "./claude/code": {
      "types": "./dist/claude/code/index.d.mts",
      "import": "./dist/claude/code/index.mjs"
    },
    "./claude/code/cli-harness": {
      "types": "./dist/claude/code/cli-harness/index.d.mts",
      "import": "./dist/claude/code/cli-harness/index.mjs"
    },
    "./harness": {
      "types": "./dist/harness.d.mts",
      "import": "./dist/harness.mjs"
    },
    "./inference": {
      "types": "./dist/inference.d.mts",
      "import": "./dist/inference.mjs"
    },
    "./session": {
      "types": "./dist/session/index.d.mts",
      "import": "./dist/session/index.mjs"
    },
    "./scripts/harness": {
      "types": "./dist/scripts/harness.d.mts",
      "import": "./dist/scripts/harness.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/organizing-with-llm-agents": "workspace:*",
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false,
  "keywords": [
    "decommissioned"
  ]
}
