{
  "name": "@red-cup-engineering/metered-inference-tollbooth",
  "version": "2.0.3",
  "description": "Official x402 v2 HTTP payment boundary for one exact RMN inference contract.",
  "type": "module",
  "private": true,
  "bin": {
    "serve-metered-inference": "./src/tollbooth.mjs"
  },
  "scripts": {
    "start": "node src/tollbooth.mjs",
    "check-runtime-admission": "node src/verify-runtime-admission.mjs",
    "check": "node --check src/tollbooth.mjs && node --check src/verify-runtime-admission.mjs && node --check test/tollbooth.test.mjs && node --check test/fixtures/deterministic-provider-executor.mjs",
    "test": "node --test test/tollbooth.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@lenticule-science/wit-transition-assay": "1.0.1",
    "@lenticule-science/witness-journal-rdf-projection-service": "1.0.3",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.1",
    "@red-cup-engineering/ni-uri-services-section": "0.1.1",
    "@red-cup-engineering/relation-model-notation-conformance": "7.0.0",
    "@red-cup-engineering/relation-model-notation-runtime": "8.0.0",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.2",
    "@red-cup-engineering/x402-services-section": "1.2.1",
    "express": "5.2.1"
  }
}
