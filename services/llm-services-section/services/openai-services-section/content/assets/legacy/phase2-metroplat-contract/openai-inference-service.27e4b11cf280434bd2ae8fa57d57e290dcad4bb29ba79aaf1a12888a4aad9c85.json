    "partial": false,
    "deterministic": false,
    "effects": ["material", "boundary", "evidence"]
  },
  "postcondition": {
    "id": "exchange-settled",
    "description": "An exchange record exists in the unit's own content/exchanges/ pool whose .outcome is exactly 'completion' (carrying the served model, response text, and finish reason) or 'refusal' (a structured refusal record stating grounds) — settled within the bounded fuel budget, never a hang and never an untyped failure.",
    "entails": ["context-packet-received"]
  },
  "phase": {
    "id": "openai-inference-exchange-phase",
    "closureDepth": "finite", "finality": "normal-form", "recurrence": "none",
    "mobility": "fixed", "coherence": "total", "contradiction": "reject",
    "coordinationCost": "evidenced", "observability": "boundary-only", "energy": "costed"
  },
  "lens": {
    "id": "openai-inference-exchange-lens",
    "domain": "context-packet",
    "boundary": "a2a-exchange-boundary-between-consuming-micro-enterprise-and-openai-inference-unit",
