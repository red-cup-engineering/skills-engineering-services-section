    ],
    "time": "interval", "caller": "required", "boundaryObject": "full"
  },
  "energetics": [{
    "kind": "metroplat.energetic-obligation",
    "id": "bounded-fuel",
    "law": "total-correctness-under-a-fuel-bound",
    "behavior": "Every exchange terminates — as completion or as refusal — inside a bounded wall-clock fuel budget; it never hangs, and it never returns an untyped failure.",
    "source": "context-packet-received", "target": "exchange-settled",
    "invariant": "fuel-consumed-by-an-exchange-is-bounded-and-recorded",
    "measure": "HTTP requests made and wall-clock seconds consumed per exchange, recorded on the exchange record",
    "evidenceRequired": true
