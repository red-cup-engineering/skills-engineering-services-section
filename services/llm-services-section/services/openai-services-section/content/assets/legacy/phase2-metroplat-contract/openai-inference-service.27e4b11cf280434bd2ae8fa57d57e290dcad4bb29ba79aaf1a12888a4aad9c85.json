    "required": true,
    "records": [
      "an-exchange-record-in-content-exchanges-with-outcome-completion-or-refusal",
      "the-completion-records-served-model-and-response-text-when-outcome-is-completion",
      "the-refusal-records-stated-grounds-when-outcome-is-refusal",
