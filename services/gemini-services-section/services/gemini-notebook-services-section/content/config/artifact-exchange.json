{
  "type": "GeminiNotebookArtifactDeliveryPolicy",
  "status": "declared",
  "route": "/artifacts/<sha256>.mp4",
  "methods": ["GET", "HEAD"],
  "authorization": "stateless HMAC-SHA256 bearer capability",
  "custody": "Cloudflare R2 immutable-content-custody",
  "maximumBytes": 536870912,
  "localArtifactDeliveryAuthority": false,
  "verification": ["immutableReference", "sha256", "byteLength", "mediaType"],
  "authorityWithheld": ["directory-listing", "unauthenticated-read", "mutation", "customer-publication", "local-file-fallback"]
}
