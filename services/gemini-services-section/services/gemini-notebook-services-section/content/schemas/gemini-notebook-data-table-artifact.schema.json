{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emsenn/schema/gemini-notebook-data-table-artifact",
  "title": "gemini-notebook-data-table-artifact",
  "type": "object",
  "required": ["format", "mediaType", "byteLength", "sha256", "rowCount", "columnCount", "header", "formulaLikeCellCount", "assayRequired", "providerArtifactId"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "csv" },
    "mediaType": { "const": "text/csv" },
    "byteLength": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "rowCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "columnCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "header": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "formulaLikeCellCount": { "type": "integer", "minimum": 0 },
    "assayRequired": { "const": true },
    "providerArtifactId": { "type": ["string", "null"], "minLength": 1 }
  }
}
