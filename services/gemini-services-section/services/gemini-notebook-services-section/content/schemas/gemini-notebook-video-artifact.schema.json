{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emsenn/schema/gemini-notebook-video-artifact",
  "title": "gemini-notebook-video-artifact",
  "$comment": "Evidence envelope for one Gemini Notebook Video Overview MP4. The contracted artifact remains the MP4 itself; this class binds the validated bytes to the requested format, style, language, and exact provider artifact identity.",
  "type": "object",
  "required": [
    "format",
    "mediaType",
    "byteLength",
    "sha256",
    "videoFormat",
    "videoStyle",
    "language",
    "providerArtifactId"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "mp4"
    },
    "mediaType": {
      "const": "video/mp4"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 12
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "videoFormat": {
      "enum": [
        "cinematic",
        "explainer"
      ]
    },
    "videoStyle": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "providerArtifactId": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "videoFormat": {
            "const": "cinematic"
          }
        },
        "required": [
          "videoFormat"
        ]
      },
      "then": {
        "properties": {
          "videoStyle": {
            "const": null
          },
          "language": {
            "const": "en"
          }
        }
      }
    }
  ],
  "x-provenance": {
    "recorded-by": "notebooklm-inference-team",
    "recorded-on": "2026-07-21"
  }
}
